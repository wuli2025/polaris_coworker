{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"outDir": "dist",
		"rootDir": ".",
		"declaration": false,
		"sourceMap": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
