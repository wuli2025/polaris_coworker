{
  "sessionDir": "~/.polaris/agentd/sessions",
  "maxSessions": 8,
  "maxQueuedMessages": 8,
  "idleTimeoutMs": 600000,
  "turnIdleTimeoutMs": 180000,
  "turnMaxMs": 0,
  "maxLineBytes": 1048576,
  "tools": [
    "read",
    "grep",
    "find",
    "ls"
  ],
  "defaultModel": {
    "provider": "anthropic",
    "id": "claude-sonnet-4-5"
  },
  "thinkingLevel": "medium",
  "logLevel": "info",
  "extensions": {
    "enabled": false
  },
  "providers": [],
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 60000
  },
  "compaction": {
    "enabled": true
  },
  "defaultToolProfile": "default",
  "toolProfiles": {
    "default": [
      "read",
      "grep",
      "find",
      "ls",
      "web_fetch",
      "web_search",
      "subagent"
    ],
    "readonly": [
      "read",
      "grep",
      "find",
      "ls",
      "web_fetch",
      "web_search",
      "subagent"
    ],
    "workspace": [
      "read",
      "grep",
      "find",
      "ls",
      "edit",
      "write",
      "web_fetch",
      "web_search",
      "subagent",
      "bash"
    ],
    "full": [
      "read",
      "grep",
      "find",
      "ls",
      "edit",
      "write",
      "bash",
      "web_fetch",
      "web_search",
      "subagent"
    ]
  },
  "attachments": {
    "maxCount": 4,
    "maxBytes": 262144,
    "maxTotalBytes": 524288,
    "mimeTypes": [
      "image/png",
      "image/jpeg",
      "image/gif",
      "image/webp"
    ]
  },
  "permissions": {
    "defaultMode": "manual",
    "timeoutMs": 60000,
    "summaryChars": 2000
  },
  "sandbox": {
    "probeTimeoutMs": 5000,
    "probeCacheMs": 10000,
    "timeoutMs": 120000,
    "shell": "sh",
    "maxOutputBytes": 262144
  },
  "subagents": {
    "maxConcurrent": 2,
    "maxDepth": 2,
    "summaryChars": 16000
  },
  "skills": {
    "paths": [
      "~/Polaris/skills"
    ]
  },
  "experts": {
    "enabled": false,
    "prompt": ""
  },
  "web": {
    "timeoutMs": 15000,
    "maxBytes": 1048576,
    "maxRedirects": 3,
    "search": {
      "endpoint": "https://api.search.brave.com/res/v1/web/search",
      "credential": "web-search",
      "maxResults": 5
    }
  },
  "oauthTimeoutMs": 600000,
  "usageDir": ""
}
