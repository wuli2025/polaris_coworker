+use super::*;
+
+fn tmp_db(tag: &str) -> std::sync::MutexGuard<'static, ()> {
+    let g = db::TEST_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let p = std::env::temp_dir().join(format!("grants-test-{}-{tag}.db", std::process::id()));
