diff --git a/src-tauri/crates/polaris-kernel/src/provider/credential_lock.rs b/src-tauri/crates/polaris-kernel/src/provider/credential_lock.rs
new file mode 100644
index 0000000..38022e6
--- /dev/null
+++ b/src-tauri/crates/polaris-kernel/src/provider/credential_lock.rs
@@ -0,0 +1,85 @@
+//! Shared generation-directory algorithm with agentd/models/credential-lock.ts.
+use super::*;
+use super::lock_owner::{self, Owner, ProcessState};
+
+pub(super) fn nonce() -> Result<String, String> {
+    let mut bytes = [0u8; 16];
+    getrandom::getrandom(&mut bytes).map_err(|_| "CredentialStoreRandomFailed")?;
+    Ok(bytes.iter().map(|b| format!("{b:02x}")).collect())
+}
+// Only this unique generation can be detached. A delayed reaper/drop can never
+// rename a replacement owner. Removing the outer directory is nonrecursive.
+pub(super) fn retire(lock: &Path, token: &str) -> Result<bool, String> {
+    let tomb = PathBuf::from(format!("{}.tomb.{}", lock.display(), nonce()?));
+    match fs::rename(lock.join(token), &tomb) {
+        Ok(()) => {},
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(false),
+        Err(_) => return Err("CredentialStoreReclaimFailed".into()),
+    }
+    let _ = fs::remove_dir(lock);
+    fs::remove_dir_all(tomb).map_err(|_| "CredentialStoreReclaimFailed")?;
+    Ok(true)
+}
+pub(super) fn reclaim(lock: &Path, max: u64) -> Result<bool, String> {
+    let entries = match fs::read_dir(lock) { Ok(e) => e, Err(_) => return Ok(false) };
+    let host = lock_owner::hostname()?;
+    for entry in entries.flatten() {
+        let token = entry.file_name().to_string_lossy().to_string();
+        if !token.strip_prefix("owner-").is_some_and(|s| !s.is_empty()
+            && s.chars().all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase() || c == '-')) { continue; }
+        let info = fs::read(entry.path().join("owner.json")).ok()
+            .and_then(|b| serde_json::from_slice::<Owner>(&b).ok());
+        let Some(info) = info.filter(|o| o.pid > 0 && !o.hostname.is_empty() && !o.process_start.is_empty()
+            && o.acquired_at <= 9007199254740991) else {
+            let age = entry.metadata().ok().and_then(|m| m.modified().ok())
+                .and_then(|t| SystemTime::now().duration_since(t).ok());
+            if age.is_some_and(|age| age > Duration::from_millis(max)) { return retire(lock, &token); }
+            continue;
+        };
+        let process = if info.hostname == host { lock_owner::process_state(info.pid) } else { ProcessState::Unknown };
+        if lock_owner::reclaimable(&info, &host, &process, now_ms(), max) { return retire(lock, &token); }
+    }
+    let _ = fs::remove_dir(lock); // Empty retired/legacy container only.
+    Ok(false)
+}
+pub struct FileLock { lock: PathBuf, token: String }
+impl FileLock {
+    pub fn acquire(path: &Path) -> Result<Self, String> {
+        let settings = super::pi_config::load()?;
+        Self::acquire_with(path, settings.lock_timeout_ms, settings.lock_poll_ms, settings.lock_max_hold_ms)
+    }
+    pub(super) fn acquire_with(path: &Path, timeout: u64, poll: u64, max: u64) -> Result<Self, String> {
+        let lock = PathBuf::from(format!("{}.lock", path.display()));
+        let token = format!("owner-{}", nonce()?);
+        let candidate = PathBuf::from(format!("{}.candidate.{}", lock.display(), nonce()?));
+        fs::create_dir_all(candidate.join(&token)).map_err(|_| "CredentialStoreLockFailed")?;
+        let result = (|| {
+            let mut info = lock_owner::owner()?;
+            let deadline = Instant::now() + Duration::from_millis(timeout);
+            loop {
+                info.acquired_at = now_ms();
+                let bytes = serde_json::to_vec(&info).map_err(|_| "CredentialStoreLockFailed")?;
+                fs::write(candidate.join(&token).join("owner.json"), bytes).map_err(|_| "CredentialStoreLockFailed")?;
+                match fs::rename(&candidate, &lock) {
+                    Ok(()) => return Ok(Self { lock, token }),
+                    Err(_) if lock.is_dir() => {
+                        reclaim(&lock, max)?;
+                        if Instant::now() >= deadline { return Err("CredentialStoreBusy".into()); }
+                        thread::sleep(Duration::from_millis(poll));
+                    }
+                    Err(_) => return Err("CredentialStoreLockFailed".into()),
+                }
+            }
+        })();
+        let _ = fs::remove_dir_all(candidate);
+        result
+    }
+    pub fn assert_owned(&self) -> Result<(), String> {
+        if self.lock.join(&self.token).join("owner.json").is_file() { Ok(()) }
+        else { Err("CredentialStoreLeaseExpired".into()) }
+    }
+}
+impl Drop for FileLock { fn drop(&mut self) { let _ = retire(&self.lock, &self.token); } }
+#[cfg(test)]
+#[path = "credential_lock_tests.rs"]
+mod tests;
diff --git a/src-tauri/crates/polaris-kernel/src/provider/lock_owner.rs b/src-tauri/crates/polaris-kernel/src/provider/lock_owner.rs
new file mode 100644
index 0000000..384a389
--- /dev/null
+++ b/src-tauri/crates/polaris-kernel/src/provider/lock_owner.rs
@@ -0,0 +1,65 @@
+use super::*;
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct Owner {
+    pub hostname: String, pub pid: u32, pub process_start: String, pub acquired_at: u64,
+}
+#[derive(Debug, Deserialize)]
+#[serde(tag = "state", rename_all = "lowercase")]
+pub(super) enum ProcessState { Alive { start: String }, Dead, Unknown }
+pub(super) fn hostname() -> Result<String, String> {
+    #[cfg(target_os = "linux")]
+    let name = fs::read_to_string("/proc/sys/kernel/hostname").map_err(|_| "CredentialStoreHostnameFailed")?;
+    #[cfg(not(target_os = "linux"))]
+    let name = {
+        let output = Command::new("hostname").output().map_err(|_| "CredentialStoreHostnameFailed")?;
+        if !output.status.success() { return Err("CredentialStoreHostnameFailed".into()); }
+        String::from_utf8(output.stdout).map_err(|_| "CredentialStoreHostnameFailed")?
+    };
+    Ok(name.trim().into())
+}
+pub(super) fn process_state(pid: u32) -> ProcessState {
+    #[cfg(target_os = "linux")]
+    {
+        let stat = match fs::read_to_string(format!("/proc/{pid}/stat")) {
+            Ok(s) => s,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return ProcessState::Dead,
+            Err(_) => return ProcessState::Unknown,
+        };
+        let Some((_, rest)) = stat.rsplit_once(") ") else { return ProcessState::Unknown; };
+        let fields: Vec<_> = rest.split_whitespace().collect();
+        if matches!(fields.first(), Some(&"Z" | &"X")) { return ProcessState::Dead; }
+        let (Some(start), Ok(boot)) = (fields.get(19), fs::read_to_string("/proc/sys/kernel/random/boot_id"))
+            else { return ProcessState::Unknown; };
+        ProcessState::Alive { start: format!("{}:{start}", boot.trim()) }
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        #[cfg(windows)]
+        let output = Command::new("powershell.exe").args(["-NoProfile", "-NonInteractive", "-Command",
+            &format!("try {{ $p = Get-Process -Id {pid} -ErrorAction Stop; $p.StartTime.ToUniversalTime().Ticks }} catch {{ if ($_.FullyQualifiedErrorId -like 'NoProcessFoundForGivenId*') {{ 'dead' }} else {{ exit 2 }} }}")]).output();
+        #[cfg(not(windows))]
+        let output = Command::new("ps").args(["-p", &pid.to_string(), "-o", "lstart="]).env("LC_ALL", "C").output();
+        match output {
+            Ok(o) if o.status.success() => {
+                let start = String::from_utf8_lossy(&o.stdout).trim().to_string();
+                if start.is_empty() || start == "dead" { ProcessState::Dead } else { ProcessState::Alive { start } }
+            }
+            #[cfg(not(windows))]
+            Ok(o) if o.status.code() == Some(1) && o.stdout.is_empty() => ProcessState::Dead,
+            _ => ProcessState::Unknown,
+        }
+    }
+}
+pub(super) fn owner() -> Result<Owner, String> {
+    let pid = std::process::id();
+    let ProcessState::Alive { start } = process_state(pid) else { return Err("CredentialStoreProcessIdentityFailed".into()); };
+    Ok(Owner { hostname: hostname()?, pid, process_start: start, acquired_at: now_ms() })
+}
+pub(super) fn reclaimable(info: &Owner, host: &str, process: &ProcessState, now: u64, max: u64) -> bool {
+    now.saturating_sub(info.acquired_at) > max || (info.hostname == host && match process {
+        ProcessState::Dead => true,
+        ProcessState::Alive { start } => start != &info.process_start,
+        ProcessState::Unknown => false,
+    })
+}
