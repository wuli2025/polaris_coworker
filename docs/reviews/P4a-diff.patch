diff --git a/agentd/src/models/file-credentials.ts b/agentd/src/models/file-credentials.ts
new file mode 100644
index 0000000..d7883b2
--- /dev/null
+++ b/agentd/src/models/file-credentials.ts
@@ -0,0 +1,94 @@
+import { mkdir, readFile, open, rename, rm } from "node:fs/promises";
+import { dirname } from "node:path";
+import { randomUUID } from "node:crypto";
+import { setTimeout as delay } from "node:timers/promises";
+import type { Credential, CredentialStore, AuthOperationOptions } from "@earendil-works/pi-ai";
+import { Redactor } from "./credentials.ts";
+
+export interface LockOptions { timeoutMs: number; pollMs: number }
+/** Same mkdir/atomic-rename contract as provider/credential_file.rs. No stale
+ * lock stealing: a timed-out waiter must never overwrite an ongoing refresh. */
+export class FileCredentials implements CredentialStore {
+  constructor(readonly path: string, private readonly redactor: Redactor,
+    private readonly locks: LockOptions = { timeoutMs: 30000, pollMs: 25 }) {
+    if (!path || !Number.isSafeInteger(locks.timeoutMs) || locks.timeoutMs <= 0
+      || !Number.isSafeInteger(locks.pollMs) || locks.pollMs <= 0) throw new Error("CredentialStoreConfigInvalid");
+  }
+  private async root(): Promise<Record<string, unknown> & { credentials?: Record<string, Credential> }> {
+    try {
+      const value = JSON.parse(await readFile(this.path, "utf8"));
+      if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error();
+      if (value.credentials && (typeof value.credentials !== "object" || Array.isArray(value.credentials))) throw new Error();
+      for (const credential of Object.values(value.credentials ?? {})) this.register(credential as Credential);
+      return value;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") return {};
+      throw new Error("CredentialStoreReadFailed");
+    }
+  }
+  private register(credential?: Credential): void {
+    if (!credential) return;
+    if (credential.type === "oauth") {
+      this.redactor.add(credential.access);
+      this.redactor.add(credential.refresh);
+    } else if (credential.type === "api_key") {
+      if (credential.key) this.redactor.add(credential.key);
+      for (const v of Object.values(credential.env ?? {})) if (typeof v === "string") this.redactor.add(v);
+    } else throw new Error("CredentialStoreInvalid");
+  }
+  private async locked<T>(work: () => Promise<T>, options?: AuthOperationOptions): Promise<T> {
+    await mkdir(dirname(this.path), { recursive: true });
+    const lock = `${this.path}.lock`;
+    const deadline = Date.now() + this.locks.timeoutMs;
+    while (true) {
+      options?.signal?.throwIfAborted();
+      try { await mkdir(lock); break; }
+      catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw new Error("CredentialStoreLockFailed");
+        if (Date.now() >= deadline) throw new Error("CredentialStoreBusy");
+        await delay(this.locks.pollMs, undefined, { signal: options?.signal });
+      }
+    }
+    try { options?.signal?.throwIfAborted(); return await work(); }
+    finally { await rm(lock, { recursive: true }); }
+  }
+  private async save(root: object): Promise<void> {
+    const temp = `${this.path}.${process.pid}.${randomUUID()}.tmp`;
+    try {
+      const file = await open(temp, "wx", 0o600);
+      try { await file.writeFile(JSON.stringify(root, null, 2)); await file.sync(); }
+      finally { await file.close(); }
+      await rename(temp, this.path);
+    } catch { throw new Error("CredentialStoreWriteFailed"); }
+    finally { await rm(temp, { force: true }); }
+  }
+  async read(id: string, options?: AuthOperationOptions): Promise<Credential | undefined> {
+    options?.signal?.throwIfAborted();
+    const entries = (await this.root()).credentials;
+    return entries && Object.hasOwn(entries, id) ? entries[id] : undefined;
+  }
+  async list(options?: AuthOperationOptions) {
+    options?.signal?.throwIfAborted();
+    return Object.entries((await this.root()).credentials ?? {}).map(([providerId, c]) => ({ providerId, type: c.type }));
+  }
+  async modify(id: string, fn: (current: Credential | undefined) => Promise<Credential | undefined>, options?: AuthOperationOptions) {
+    return this.locked(async () => {
+      const root = await this.root();
+      const entries = root.credentials ??= Object.create(null) as Record<string, Credential>;
+      const credential = await fn(Object.hasOwn(entries, id) ? entries[id] : undefined);
+      if (credential !== undefined) {
+        this.register(credential);
+        Object.defineProperty(entries, id, { value: credential, enumerable: true, configurable: true, writable: true });
+        await this.save(root);
+      }
+      return entries[id];
+    }, options);
+  }
+  async delete(id: string, options?: AuthOperationOptions): Promise<void> {
+    await this.locked(async () => {
+      const root = await this.root();
+      if (root.credentials) delete root.credentials[id];
+      await this.save(root);
+    }, options);
+  }
+}
diff --git a/agentd/src/models/logins.ts b/agentd/src/models/logins.ts
new file mode 100644
index 0000000..66f8515
--- /dev/null
+++ b/agentd/src/models/logins.ts
@@ -0,0 +1,83 @@
+import type { AuthEvent, AuthPrompt } from "@earendil-works/pi-ai";
+import type { Models } from "./runtime.ts";
+import { DaemonError } from "../protocol/errors.ts";
+interface Snapshot {
+  status: "pending" | "ok" | "failed" | "idle";
+  url?: string; userCode?: string; interval?: number; expiresIn?: number;
+  prompt?: string;
+}
+interface Login {
+  controller: AbortController;
+  state: Snapshot;
+  answer?: (value: string) => void;
+  done: Promise<void>;
+}
+/** UI-neutral SDK OAuth flows. Responses contain login interaction data only. */
+export class Logins {
+  private readonly active = new Map<string, Login>();
+  constructor(private readonly models: Models, private readonly timeoutMs: () => number) {}
+  async handle(provider: string, operation: string, input?: string): Promise<Snapshot> {
+    if (!["anthropic", "openai-codex"].includes(provider)) throw new DaemonError("OAUTH_UNSUPPORTED", "Unsupported OAuth provider");
+    if (operation === "cancel") {
+      const old = this.active.get(provider);
+      old?.controller.abort();
+      await old?.done;
+      this.active.delete(provider);
+      return { status: "idle" };
+    }
+    if (operation === "poll") return { ...(this.active.get(provider)?.state ?? { status: "idle" }) };
+    if (operation === "respond") {
+      const login = this.active.get(provider);
+      if (!login?.answer || !input) throw new DaemonError("OAUTH_INPUT_NOT_PENDING", "No login prompt awaits input");
+      login.answer(input);
+      login.answer = undefined;
+      await login.done;
+      return { ...login.state };
+    }
+    if (operation !== "start") throw new DaemonError("INVALID_REQUEST", "Unknown OAuth operation");
+    await this.handle(provider, "cancel");
+    const controller = new AbortController();
+    const login: Login = { controller, state: { status: "pending" }, done: Promise.resolve() };
+    this.active.set(provider, login);
+    let ready!: () => void;
+    const available = new Promise<void>((resolve) => { ready = resolve; });
+    const timeout = setTimeout(() => controller.abort(), this.timeoutMs());
+    const notify = (event: AuthEvent) => {
+      if (event.type === "auth_url") { login.state.url = event.url; ready(); }
+      if (event.type === "device_code") {
+        Object.assign(login.state, { url: event.verificationUri, userCode: event.userCode,
+          interval: event.intervalSeconds, expiresIn: event.expiresInSeconds });
+        ready();
+      }
+    };
+    const prompt = async (event: AuthPrompt): Promise<string> => {
+      if (event.type === "select") {
+        const requested = input === "device" ? "device_code" : "browser";
+        const choice = event.options.find((option) => option.id === requested);
+        if (!choice) throw new Error("OAuthSelectionUnsupported");
+        return choice.id;
+      }
+      login.state.prompt = event.type;
+      ready();
+      return new Promise((resolve, reject) => {
+        const signal = event.signal ?? controller.signal;
+        const abort = () => { login.answer = undefined; reject(new Error("OAuthCancelled")); };
+        if (signal.aborted) { abort(); return; }
+        signal.addEventListener("abort", abort, { once: true });
+        login.answer = (value) => { signal.removeEventListener("abort", abort); resolve(value); };
+      });
+    };
+    login.done = this.models.runtime.login(provider, "oauth", { signal: controller.signal, notify, prompt })
+      .then((credential) => {
+        if (credential.type === "oauth") { this.models.redactor.add(credential.access); this.models.redactor.add(credential.refresh); }
+        login.state = { status: "ok" };
+      }, () => { login.state = { status: "failed" }; })
+      .finally(() => { clearTimeout(timeout); login.answer = undefined; ready(); });
+    await available;
+    return { ...login.state };
+  }
+  async shutdown(): Promise<void> {
+    for (const login of this.active.values()) login.controller.abort();
+    await Promise.all([...this.active.values()].map((login) => login.done));
+  }
+}
