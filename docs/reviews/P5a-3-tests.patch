+import { createRequire } from 'node:module';
+import { readFileSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import assert from 'node:assert/strict';
+const require = createRequire(resolve(process.argv[2], 'package.json'));
+const photon = require('@silvia-odwyer/photon-node');
+const picture = new photon.PhotonImage(new Uint8Array([255, 0, 0, 255]), 1, 1);
+assert.equal(picture.get_width(), 1);
+picture.free();
+const { QuickJS } = await import(pathToFileURL(require.resolve('quickjs-wasi')).href);
+const vm = await QuickJS.create({ wasm: readFileSync(require.resolve('quickjs-wasi/quickjs.wasm')) });
+const result = vm.evalCode('1 + 2');
+assert.equal(result.toNumber(), 3);
+result[Symbol.dispose]();
+vm[Symbol.dispose]();
+console.log(`WASM OK: photon + quickjs-wasi on ${process.platform}/${process.arch}`);
+
+const tui = dirname(require.resolve('@earendil-works/pi-tui/package.json'));
+const target = `${process.platform}-${process.arch}`;
+const name = `${process.platform}-platform${process.platform === 'linux' ? '-x11' : ''}.node`;
+const native = require(resolve(tui, 'native', process.platform, 'prebuilds', target, name));
+assert.ok(Object.keys(native).length > 0);
+console.log(`Native addon load OK: pi-tui ${target}`);
diff --git a/scripts/runtime/node.mjs b/scripts/runtime/node.mjs
new file mode 100644
index 0000000..56b804e
--- /dev/null
+++ b/scripts/runtime/node.mjs
@@ -0,0 +1,46 @@
+import { createHash } from 'node:crypto';
+import { nodeUrls } from './sources.mjs';
+
+export function nodeVersion(engine, override) {
+  const match = /^>=(\d+\.\d+\.\d+)$/.exec(engine);
+  if (!match) throw new Error(`Unsupported Node engine: ${engine}`);
+  const version = override ?? match[1];
+  if (!/^\d+\.\d+\.\d+$/.test(version)) throw new Error('Node version must be x.y.z');
+  const a = version.split('.').map(Number), b = match[1].split('.').map(Number);
+  const difference = a.map((n, i) => n - b[i]).find(n => n !== 0) ?? 0;
+  if (difference < 0) throw new Error(`Node ${version} does not satisfy ${engine}`);
+  return version;
+}
+
+export function nodePlan(version, platform, arch, sources = {}) {
+  if (typeof version !== 'string' || !/^\d+\.\d+\.\d+$/.test(version)) throw new Error('Node version must be x.y.z');
+  if (!['win32', 'darwin', 'linux'].includes(platform) || !['x64', 'arm64'].includes(arch)) {
+    throw new Error(`Unsupported Node target: ${platform}/${arch}`);
+  }
+  const win = platform === 'win32';
+  const asset = `node-v${version}-${win ? 'win' : platform}-${arch}.${win ? 'zip' : 'tar.gz'}`;
+  const official = `https://nodejs.org/dist/v${version}`;
+  return {
+    name: 'node', dir: 'node', asset, magic: win ? '504b' : '1f8b',
+    minBytes: 10 * 1024 * 1024, strip: 1, check: win ? 'node.exe' : 'bin/node',
+    urls: nodeUrls(version, asset, sources),
+    checksumUrl: `${official}/SHASUMS256.txt`,
+  };
+}
+
+export function checksumFor(manifest, asset) {
+  const matches = manifest.split(/\r?\n/).map(line => /^([a-fA-F0-9]{64})\s+\*?(\S+)$/.exec(line))
+    .filter(match => match?.[2] === asset);
+  if (matches.length !== 1) throw new Error(`Missing or duplicate official SHA256 for ${asset}`);
+  return matches[0][1].toLowerCase();
+}
+
+export function verifySha256(bytes, expected) {
+  if (!/^[a-f0-9]{64}$/.test(expected) || createHash('sha256').update(bytes).digest('hex') !== expected) {
+    throw new Error('Node SHA256 mismatch');
+  }
+}
+
+export function componentCurrent(have, want, name, intact) {
+  return intact && have?.platform === want.platform && have?.arch === want.arch && have?.[name] === want[name];
+}
diff --git a/scripts/runtime/node.test.mjs b/scripts/runtime/node.test.mjs
new file mode 100644
index 0000000..ed201d2
--- /dev/null
+++ b/scripts/runtime/node.test.mjs
@@ -0,0 +1,41 @@
+// Keep the same assertions runnable by both required test commands.
+const { test } = await import(process.env.VITEST ? 'vitest' : 'node:test');
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { nodeVersion, nodePlan, checksumFor, verifySha256, componentCurrent } from './node.mjs';
+test('Node engine minimum and explicit versions are validated', () => {
+  assert.equal(nodeVersion('>=22.19.0'), '22.19.0');
+  assert.equal(nodeVersion('>=22.19.0', '24.1.0'), '24.1.0');
+  for (const v of ['22.18.9', '20.99.0', 'latest', '22.19.0/evil']) {
+    assert.throws(() => nodeVersion('>=22.19.0', v));
+  }
+  assert.throws(() => nodeVersion('^22'));
+});
+test('official artifacts cover six supported targets and ordered mirrors', () => {
+  for (const platform of ['win32', 'darwin', 'linux']) for (const arch of ['x64', 'arm64']) {
+    const plan = nodePlan('22.19.0', platform, arch);
+    assert.ok(plan.urls[0].startsWith('https://nodejs.org/dist/'));
+    assert.ok(plan.urls[1].includes('llmwiki.cloud'));
+    assert.ok(plan.urls.every(url => !/ghfast|ghproxy/.test(url)));
+    assert.ok(plan.asset.includes(arch));
+    assert.equal(plan.check, platform === 'win32' ? 'node.exe' : 'bin/node');
+  }
+  assert.throws(() => nodePlan('22.19.0', 'linux', 'ia32'));
+});
+test('checksum requires exact unique asset and rejects corruption and HTML', () => {
+  const data = Buffer.from('portable node fixture');
+  const hash = createHash('sha256').update(data).digest('hex');
+  assert.equal(checksumFor(`${hash}  node.zip\n`, 'node.zip'), hash);
+  verifySha256(data, hash);
+  assert.throws(() => verifySha256(Buffer.from('<html>proxy failure'), hash));
+  assert.throws(() => checksumFor(`${hash}  node.zip.old`, 'node.zip'));
+  assert.throws(() => checksumFor(`${hash}  node.zip\n${hash}  node.zip`, 'node.zip'));
+});
+test('existing binary cannot hide a version or target change', () => {
+  const want = {platform: 'win32', arch: 'x64', node: '22.19.0'};
+  assert.equal(componentCurrent(want, want, 'node', true), true);
+  for (const have of [undefined, {...want, node: '20.0.0'}, {...want, arch: 'arm64'}]) {
+    assert.equal(componentCurrent(have, want, 'node', true), false);
+  }
+  assert.equal(componentCurrent(want, want, 'node', false), false);
+});
diff --git a/scripts/runtime/sources.mjs b/scripts/runtime/sources.mjs
new file mode 100644
index 0000000..d0ffc85
--- /dev/null
+++ b/scripts/runtime/sources.mjs
@@ -0,0 +1,23 @@
+// GitHub release proxies cannot serve nodejs.org assets.
+export const defaultDepsBase = 'https://llmwiki.cloud/downloads/deps';
+
+function baseUrl(value) {
+  if (typeof value !== 'string') throw new TypeError('Runtime source must be a URL string');
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash) {
+    throw new Error('Runtime sources must use HTTPS without credentials, query or fragment');
+  }
+  return value.replace(/\/+$/, '');
+}
+
+export function nodeUrls(version, asset, { deps = defaultDepsBase, mirror } = {}) {
+  const official = `https://nodejs.org/dist/v${version}/${asset}`;
+  return [official, ...(deps === '' ? [] : [`${baseUrl(deps)}/${asset}`]),
+    ...(mirror === undefined || mirror === '' ? [] : [`${baseUrl(mirror)}/v${version}/${asset}`])];
+}
+
+export function githubUrls(repo, tag, asset, { deps = defaultDepsBase } = {}) {
+  const official = `https://github.com/${repo}/releases/download/${tag}/${asset}`;
+  return [...(deps === '' ? [] : [`${baseUrl(deps)}/${asset}`]),
+    `https://ghfast.top/${official}`, `https://ghproxy.net/${official}`, official];
+}
