+    try {
+      const stop = await listen<T>(name, callback);
+      if (disposed) stop(); else stops.push(stop);
+    } catch (e) { if (!disposed) login.error.value = errMsg(e); }
+  }
+  watch(() => collab.authed, authed => { if (authed) void refresh(); else security.reset(); });
+  onMounted(() => {
+    if (isTauri) {
+      void subscribe<Progress>('interconnect:progress', progress => login.receive({ interconnect: progress }));
+      void subscribe<Notice | Approval>('interconnect:security', event => {
+        if (!disposed && collab.authed) security.receive(event);
+      });
+      void refresh();
+      poll = setInterval(() => void refresh(), config.pollMs);
+      retry = setInterval(() => void security.tick(), config.retryMs);
+    }
+  });
+  onUnmounted(() => {
+    disposed = true;
+    login.dispose();
+    security.reset();
+    stops.forEach(stop => stop());
+    clearInterval(poll);
+    clearInterval(retry);
+  });
+  function withPorts(devices: Device[]) {
+    return devices.filter(d => !d.revoked).map(d => ({ ...d, port: ports.value[d.nodeId] }));
+  }
+  return { login, security, passwordLogin, emailDone, logout, invoke, revokeNotice, withPorts };
+}
diff --git a/src/features/interconnect/useLogin.ts b/src/features/interconnect/useLogin.ts
new file mode 100644
index 0000000..923ce7a
--- /dev/null
+++ b/src/features/interconnect/useLogin.ts
@@ -0,0 +1,70 @@
+import { ref } from 'vue';
+import { errMsg } from '../../lib/err';
+import { interconnectCopy as c } from './copy';
+import type { Command, Progress, RelayConfig } from './contracts';
+
+export interface LoginResult {
+  enrolled?: boolean; token?: string; interconnect?: Progress; relayConfig?: RelayConfig;
+  authorityConfigured?: boolean; configurationError?: string;
+}
+export function useLogin(command: Command, adopt: (token: string) => Promise<void>, slowMs: number) {
+  const progress = ref<Progress | null>(null);
+  const relay = ref<RelayConfig>();
+  const error = ref('');
+  const busy = ref(false);
+  const enrolled = ref(false);
+  const authorityConfigured = ref<boolean>();
+  let pollBusy = false;
+  let disposed = false;
+  function receive(result: LoginResult) {
+    if (disposed) return;
+    if (result.interconnect) progress.value = result.interconnect;
+    if (result.relayConfig) relay.value = result.relayConfig;
+    if (result.enrolled !== undefined) enrolled.value = result.enrolled;
+    if (result.authorityConfigured !== undefined) authorityConfigured.value = result.authorityConfigured;
+    if (result.configurationError) error.value = result.configurationError;
+  }
+  async function refresh() {
+    if (pollBusy || disposed) return;
+    pollBusy = true;
+    try { receive(await command<LoginResult>('mesh_status')); }
+    catch (e) { if (!disposed) error.value = errMsg(e); }
+    finally { pollBusy = false; }
+  }
+  async function done(result: LoginResult) {
+    receive(result);
+    if (result.token) await adopt(result.token);
+  }
+  async function execute(action: () => Promise<LoginResult>) {
+    if (busy.value || disposed) return;
+    busy.value = true;
+    error.value = '';
+    const timer = setTimeout(() => { if (!disposed) error.value = c.timeout; }, slowMs);
+    try {
+      const result = await action();
+      if (!disposed) error.value = '';
+      await done(result);
+    }
+    catch (e) {
+      if (!disposed) {
+        error.value = errMsg(e);
+        if (progress.value?.state !== 'failed') progress.value = null;
+      }
+    }
+    finally { clearTimeout(timer); busy.value = false; }
+  }
+  async function login(username: string, password: string) {
+    progress.value = null;
+    await execute(async () => {
+      await command('collab_host_start');
+      return command<LoginResult>('account_login_password', { username, password });
+    });
+  }
+  async function retry() {
+    if (!enrolled.value || progress.value?.stage === 'register') return;
+    await execute(() => command<LoginResult>('mesh_sync'));
+    await refresh();
+  }
+  function dispose() { disposed = true; }
+  return { progress, relay, error, busy, enrolled, authorityConfigured, receive, refresh, done, login, retry, dispose };
+}
diff --git a/src/features/interconnect/useSecurity.ts b/src/features/interconnect/useSecurity.ts
new file mode 100644
index 0000000..a24fc7f
--- /dev/null
+++ b/src/features/interconnect/useSecurity.ts
@@ -0,0 +1,89 @@
+import { ref } from 'vue';
+import { errMsg } from '../../lib/err';
+import { interconnectCopy as c } from './copy';
+import type { Approval, Command, Inbox, Notice } from './contracts';
+
+// Retain the exact closure only in memory. Never persist credentials or replay after navigation.
+export function useSecurity(command: Command) {
+  const notices = ref<Notice[]>([]);
+  const approvals = ref<Approval[]>([]);
+  const pending = ref('');
+  const error = ref('');
+  const busy = ref(false);
+  const acknowledged = new Set<string>();
+  let operation: (() => Promise<unknown>) | undefined;
+  let generation = 0;
+  let polling = false;
+
+  function receive(event: Notice | Approval) {
+    if ('deviceId' in event && event.kind === 'device_enrolled') {
+      if (!acknowledged.has(event.deviceId)) {
+        notices.value = [...notices.value.filter(n => n.deviceId !== event.deviceId), event];
+      }
+    } else if ('id' in event) {
+      approvals.value = [...approvals.value.filter(a => a.id !== event.id), event];
+    }
+  }
+  async function refresh() {
+    if (polling) return;
+    polling = true;
+    const epoch = generation;
+    try {
+      const inbox = await command<Inbox>('mesh_security_inbox');
+      if (epoch !== generation) return;
+      inbox.notifications.forEach(receive);
+      approvals.value = inbox.approvals;
+    } catch (e) { if (epoch === generation) error.value = errMsg(e); }
+    finally { polling = false; }
+  }
+  async function ack(deviceId: string) {
+    const epoch = generation;
+    try {
+      await command('mesh_security_ack', { deviceId });
+      if (epoch !== generation) return false;
+      acknowledged.add(deviceId);
+      notices.value = notices.value.filter(n => n.deviceId !== deviceId);
+      return true;
+    } catch (e) { if (epoch === generation) error.value = errMsg(e); return false; }
+  }
+  async function decide(requestId: string, approve: boolean) {
+    if (busy.value) return;
+    busy.value = true;
+    const epoch = generation;
+    try {
+      await command('mesh_risk_decide', { requestId, approve });
+      if (epoch === generation) approvals.value = approvals.value.filter(a => a.id !== requestId);
+    } catch (e) { if (epoch === generation) error.value = errMsg(e); }
+    finally { busy.value = false; }
+  }
+  async function attempt() {
+    if (!operation || busy.value) return;
+    busy.value = true;
+    const epoch = generation;
+    try {
+      await operation();
+      if (epoch === generation) { operation = undefined; pending.value = ''; error.value = ''; }
+    } catch (e) {
+      if (epoch !== generation) return;
+      const message = errMsg(e);
+      const id = message.match(/approval_pending:([A-Za-z0-9_-]+)/)?.[1];
+      if (id) { pending.value = id; error.value = ''; }
+      else {
+        pending.value = '';
+        // Explicit user retry is required after denial, expiry, offline failure or partial mutation.
+        error.value = message.includes('approval_expired_or_denied:') ? c.expired
+          : message.includes(c.offlineRisk) ? c.offlineRisk : message;
+      }
+    } finally { busy.value = false; }
+  }
+  async function run(action: () => Promise<unknown>) {
+    if (busy.value || pending.value) { error.value = c.pendingOperation; return; }
+    operation = action;
+    error.value = '';
+    await attempt();
+  }
+  async function tick() { if (pending.value) await attempt(); }
+  function cancel() { generation++; operation = undefined; pending.value = ''; error.value = ''; }
+  function reset() { cancel(); notices.value = []; approvals.value = []; acknowledged.clear(); }
+  return { notices, approvals, pending, error, busy, receive, refresh, ack, decide, run, tick, retry: attempt, cancel, reset };
+}
