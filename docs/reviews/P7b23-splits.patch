+/// 邮箱对得上、但那一行已经绑在**另一个**云端账号上:不抢,报清楚。
+#[test]
+fn console_login_refuses_to_steal_a_row_bound_to_another_account() {
+    let _g = tmp_env();
+    upsert_member(
+        &claims_of("acct_a", "alice", "a@q.com"),
