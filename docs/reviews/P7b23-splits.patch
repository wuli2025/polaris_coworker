+    let u = upsert_member(&attacker, Admission::Invited("owner".into())).unwrap();
+    assert_eq!(u.role, "owner", "他确实成了本机 owner(票据给的)");
+    // 但「本机主人」这个身份没被他抢走 —— 他的设备走不了 SelfOwned 那条免票据的路。
+    assert_eq!(owner_uid(), "acct_me", "主人 uid 不该被后来的 owner 覆盖");
+}
