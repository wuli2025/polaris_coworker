@@ -0,0 +1,83 @@
+//! Both mesh constructors must consume the authority CA, including long polling.
+use super::*;
+use std::{fs, io::{Read, Write}, net::TcpListener, process::Command, sync::Arc};
+use ureq::rustls::{self, pki_types::{CertificateDer, PrivateKeyDer, pem::PemObject}};
+
+type TestResult = Result<(), Box<dyn std::error::Error>>;
+#[test]
+fn ordinary_and_watch_clients_share_private_ca_policy() -> TestResult {
+    let dir = std::env::temp_dir().join(format!("p7-mesh-tls-{}", std::process::id()));
+    fs::create_dir_all(&dir)?;
+    let config_path = dir.join("interconnect.json");
+    let previous = std::env::var_os("POLARIS_INTERCONNECT_CONFIG");
+    struct Restore(Option<std::ffi::OsString>, std::path::PathBuf);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            match &self.0 {
+                Some(value) => std::env::set_var("POLARIS_INTERCONNECT_CONFIG", value),
+                None => std::env::remove_var("POLARIS_INTERCONNECT_CONFIG"),
+            }
+            let _ = fs::remove_dir_all(&self.1);
+        }
+    }
+    let _restore = Restore(previous, dir.clone());
+    std::env::set_var("POLARIS_INTERCONNECT_CONFIG", &config_path);
+    fs::write(&config_path, json!({"authority":{"extraCaPem":"/missing/p7-mesh-ca.pem"}}).to_string())?;
+    assert!(transport::agent().is_err());
+    assert!(security::watch_agent(1).is_err());
+    let openssl = |args: &[&str]| -> TestResult {
+        let output = Command::new("openssl").args(args).current_dir(&dir).output()?;
+        if !output.status.success() { return Err(String::from_utf8_lossy(&output.stderr).into_owned().into()); }
+        Ok(())
+    };
+    openssl(&["req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "1", "-subj", "/CN=Mesh Test CA",
+        "-addext", "basicConstraints=critical,CA:TRUE", "-keyout", "ca.key", "-out", "ca.pem"])?;
+    openssl(&["req", "-newkey", "rsa:2048", "-nodes", "-subj", "/CN=localhost",
+        "-keyout", "server.key", "-out", "server.csr"])?;
+    fs::write(dir.join("extensions"), "subjectAltName=DNS:localhost\nextendedKeyUsage=serverAuth\nbasicConstraints=critical,CA:FALSE\n")?;
+    openssl(&["x509", "-req", "-days", "1", "-in", "server.csr", "-CA", "ca.pem", "-CAkey", "ca.key",
+        "-CAcreateserial", "-extfile", "extensions", "-out", "server.pem"])?;
+    let certificates = CertificateDer::pem_slice_iter(&fs::read(dir.join("server.pem"))?).collect::<Result<Vec<_>, _>>()?;
+    let key = PrivateKeyDer::from_pem_slice(&fs::read(dir.join("server.key"))?)?;
+    let tls = Arc::new(rustls::ServerConfig::builder_with_provider(Arc::new(rustls::crypto::ring::default_provider()))
+        .with_safe_default_protocol_versions()?.with_no_client_auth().with_single_cert(certificates, key)?);
+    let listener = TcpListener::bind("127.0.0.1:0")?;
+    let port = listener.local_addr()?.port();
+    listener.set_nonblocking(true)?;
+    let server = std::thread::spawn(move || -> Result<(), String> {
+        let deadline = std::time::Instant::now() + Duration::from_secs(20);
+        let mut attempts = 0;
+        while attempts < 6 && std::time::Instant::now() < deadline {
+            let (socket, _) = match listener.accept() {
+                Ok(socket) => socket,
+                Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                    std::thread::sleep(Duration::from_millis(5)); continue;
+                }
+                Err(error) => return Err(error.to_string()),
+            };
+            attempts += 1;
+            socket.set_read_timeout(Some(Duration::from_secs(2))).map_err(|e| e.to_string())?;
+            socket.set_write_timeout(Some(Duration::from_secs(2))).map_err(|e| e.to_string())?;
+            let connection = rustls::ServerConnection::new(tls.clone()).map_err(|e| e.to_string())?;
+            let mut stream = rustls::StreamOwned::new(connection, socket);
+            if stream.read(&mut [0; 4096]).is_ok() {
+                let _ = stream.write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok");
+            }
+        }
+        if attempts != 6 { return Err("missing TLS attempts".into()); }
+        Ok(())
+    });
+    for trusted in [false, true] {
+        let ca = trusted.then(|| dir.join("ca.pem"));
+        fs::write(&config_path, json!({"authority":{"extraCaPem":ca}}).to_string())?;
+        for client in [transport::agent()?, security::watch_agent(1)?] {
+            assert_eq!(client.get(&format!("https://localhost:{port}")).call().is_ok(), trusted);
+            if trusted {
+                let error = client.get(&format!("https://127.0.0.1:{port}")).call().err().ok_or("hostname mismatch accepted")?;
+                assert!(cloud_err(error).contains("InterconnectTlsCertificateError"));
+            }
+        }
+    }
+    server.join().map_err(|_| "TLS server panicked")??;
+    Ok(())
+}
diff --git a/src-tauri/src/mesh/transport.rs b/src-tauri/src/mesh/transport.rs
new file mode 100644
index 0000000..b6f0666
--- /dev/null
+++ b/src-tauri/src/mesh/transport.rs
@@ -0,0 +1,117 @@
+//! Authority HTTP and transport policy.
+use super::*;
+
+// ────────────────────────────── 与云端目录通信 ──────────────────────────────
+
+pub(super) fn agent() -> Result<ureq::Agent, String> {
+    crate::collab::interconnect::http_client::agent(ureq::AgentBuilder::new()
+        .timeout_connect(CLOUD_TIMEOUT)
+        .timeout_read(CLOUD_TIMEOUT))
+}
+
+/// 把 ureq 错误翻成人话。云端明确给的业务错误原样透传(「设备已被移出设备网」这类
+/// 必须让用户看见原文,糊成「网络错误」会让人对着正确的账号反复试)。
+pub(super) fn cloud_err(e: ureq::Error) -> String {
+    match e {
+        ureq::Error::Status(code, resp) => {
+            let body = resp.into_string().unwrap_or_default();
+            serde_json::from_str::<Value>(&body)
+                .ok()
+                .and_then(|v| v.get("error").and_then(|x| x.as_str()).map(String::from))
+                .unwrap_or_else(|| format!("HTTP {code}"))
+        }
+        error => crate::collab::interconnect::http_client::diagnostic(&error),
+    }
+}
+
+pub(super) fn norm_url(u: &str) -> String {
+    let t = u.trim().trim_end_matches('/');
+    if t.starts_with("http://") || t.starts_with("https://") {
+        t.to_string()
+    } else {
+        format!("https://{t}")
+    }
+}
+
+fn loopback_http(url: &str) -> bool {
+    let Some(rest) = url.strip_prefix("http://") else {
+        return false;
+    };
+    let authority = rest.split('/').next().unwrap_or("");
+    let host = authority.rsplit('@').next().unwrap_or(authority);
+    host == "localhost"
+        || host.starts_with("localhost:")
+        || host == "127.0.0.1"
+        || host.starts_with("127.0.0.1:")
+        || host == "[::1]"
+        || host.starts_with("[::1]:")
+}
+
+/// 登录凭据、OTP、assertion 与长期 meshKey 都会经过账号中心。公网 HTTP 必须显式确认，
+/// 不能再因为用户把“高级地址”留空，就静默把整套身份发到明文 IP。
+pub(super) fn validate_authority_url(raw: &str, allow_insecure_http: bool) -> Result<String, String> {
+    if raw.trim().is_empty() {
+        return Err("未配置权威；当前可继续使用本地模式".into());
+    }
+    let url = norm_url(raw);
+    if url == "https://" || url == "http://" {
+        return Err("请填写账号中心地址".into());
+    }
+    if url.starts_with("https://") || loopback_http(&url) {
+        return Ok(url);
+    }
+    if url.starts_with("http://") {
+        if allow_insecure_http {
+            return Ok(url);
+        }
+        return Err(format!(
+            "账号中心 {url} 使用明文 HTTP，邮箱、验证码和设备密钥可能被窃取。请改用 HTTPS；若这是你明确信任的旧服务，请在高级设置勾选‘仍使用不安全 HTTP’后重试"
+        ));
+    }
+    Err("账号中心地址只支持 https://（本机调试可用 http://localhost）".into())
+}
+
+pub(super) fn authority_transport_state(url: &str) -> &'static str {
+    if url.starts_with("https://") || loopback_http(url) {
+        "secure"
+    } else {
+        "insecure_legacy"
+    }
+}
+
+/// 心跳 + 取同账号设备清单。
+pub(super) fn announce(c: &Cfg) -> Result<Value, String> {
+    crate::collab::authority::pin_explicit(&c.url)?;
+    crate::collab::db::meta_set("mesh_node_id", &my_node_id())?;
+    let resp = agent()?
+        .post(&format!("{}/api/mesh/announce", c.url))
+        .set("Authorization", &format!("Bearer {}", c.key))
+        .send_json(json!({ "name": my_name(), "os": my_os(), "ver": my_ver() }))
+        .map_err(cloud_err)?;
+    let v: Value = resp
+        .into_json()
+        .map_err(|e| format!("云端返回的不是 JSON:{e}"))?;
+    if let Some(uid) = v.get("uid").and_then(|x| x.as_str()) {
+        let _ = crate::collab::db::meta_set(K_UID, uid);
+    }
+    security::publish(&v);
+    Ok(v)
+}
+
+/// 取一张新的身份断言(5 分钟有效),用来进对端主机的门。
+pub(super) fn fresh_assertion(c: &Cfg) -> Result<String, String> {
+    crate::collab::authority::pin_explicit(&c.url)?;
+    let resp = agent()?
+        .post(&format!("{}/api/mesh/assert", c.url))
+        .set("Authorization", &format!("Bearer {}", c.key))
+        .send_json(json!({}))
+        .map_err(cloud_err)?;
+    let v: Value = resp
+        .into_json()
+        .map_err(|e| format!("云端返回的不是 JSON:{e}"))?;
+    v.get("assertion")
+        .and_then(|x| x.as_str())
+        .map(String::from)
+        .ok_or_else(|| "云端没返回身份断言".into())
+}
+
diff --git a/src-tauri/tests/provider_http.rs b/src-tauri/tests/provider_http.rs
new file mode 100644
index 0000000..169a7da
--- /dev/null
+++ b/src-tauri/tests/provider_http.rs
@@ -0,0 +1,62 @@
+#![cfg(all(feature = "server", not(feature = "desktop")))]
+//! Exercise the public HTTP error envelope and the shared Tauri command return.
+use axum::{body::{Body, to_bytes}, http::{Request, StatusCode}};
+use polaris_app_lib::{apihub::{api_router, ApiState}, host::AppHandle};
+use polaris_kernel::{provider, chat::backend};
+use serde_json::{json, Value};
+use std::{fs, sync::Arc, path::Path};
+use tower::ServiceExt;
+
+#[tokio::test(flavor = "multi_thread")]
+async fn invalid_native_save_preserves_paths_through_http_and_command_return() -> Result<(), Box<dyn std::error::Error>> {
+    let dir = std::env::temp_dir().join(format!("p7-http-{}", std::process::id()));
+    fs::create_dir_all(&dir)?;
+    std::env::set_var("POLARIS_COLLAB_DB", dir.join("collab.db"));
+    std::env::set_var("POLARIS_INTERCONNECT_CONFIG", dir.join("interconnect.json"));
+    fs::write(dir.join("interconnect.json"), "{}")?;
+    let repo = Path::new(env!("CARGO_MANIFEST_DIR")).join("..");
+    let config = dir.join("agent.json");
+    fs::write(&config, serde_json::to_vec(&json!({"agent":{"backend":"pi"},"agentd":{
+        "entry":repo.join("src-tauri/crates/polaris-kernel/tests/fixtures/fake-agentd.mjs"),
+        "isolation":"shared","sessionMap":dir.join("sessions"),
+        "expertSettings":dir.join("experts.json"),"requestTimeoutMs":30000
+    }}))?)?;
+    std::env::set_var("POLARIS_AGENT_CONFIG", &config);
+    std::env::set_var("POLARIS_PROVIDER_STORE", dir.join("providers.json"));
+    let (tx, _) = tokio::sync::broadcast::channel(32);
+    let router = api_router(ApiState { app: AppHandle::new(tx.clone()), tx,
+        auth_token: Arc::new(Some("p7-http-test-token".into())), open_no_auth: false });
+    // Saving validates locally; switching still preserves SDK WireError.paths.
+    let input = json!({"id":"codex","name":"bad","settingsConfig":{"models":[{"id":"invalid","maxTokens":0}]}});
+    let response = router.clone().oneshot(Request::post("/api/invoke")
+        .header("content-type", "application/json").header("authorization", "Bearer p7-http-test-token")
+        .body(Body::from(json!({"cmd":"provider_save","args":{"input":input}}).to_string()))?).await?;
+    assert_eq!(response.status(), StatusCode::INTERNAL_SERVER_ERROR);
+    let body: Value = serde_json::from_slice(&to_bytes(response.into_body(), 65536).await?)?;
+    let expected = provider::provider_save(serde_json::from_value(input)?).err().ok_or("invalid save accepted")?;
+    assert_eq!(body["error"], expected);
+    assert!(expected.contains("/settingsConfig/models/0/maxTokens"), "{expected}");
+    provider::provider_save(serde_json::from_value(json!({"id":"codex","name":"SDK rejected",
+        "settingsConfig":{"models":["invalid-wire-config"]}}))?)?;
+    let response = router.clone().oneshot(Request::post("/api/invoke")
+        .header("content-type", "application/json").header("authorization", "Bearer p7-http-test-token")
+        .body(Body::from(json!({"cmd":"provider_switch","args":{"id":"codex"}}).to_string()))?).await?;
+    assert_eq!(response.status(), StatusCode::INTERNAL_SERVER_ERROR);
+    let body: Value = serde_json::from_slice(&to_bytes(response.into_body(), 65536).await?)?;
+    assert!(body["error"].as_str().is_some_and(|error| error.contains("/providers/0/models/0/name")));
+    for (cmd, args) in [
+        ("provider_save", json!({"input":{"id":"codex","name":"Drill subscription","settingsConfig":{"models":["gpt-6-astra"]}}})),
+        ("provider_switch", json!({"id":"codex"})),
+    ] {
+        let response = router.clone().oneshot(Request::post("/api/invoke")
+            .header("content-type", "application/json").header("authorization", "Bearer p7-http-test-token")
+            .body(Body::from(json!({"cmd":cmd,"args":args}).to_string()))?).await?;
+        let status = response.status();
+        let body: Value = serde_json::from_slice(&to_bytes(response.into_body(), 65536).await?)?;
+        assert_eq!(status, StatusCode::OK, "{cmd}: {body}");
+        assert_eq!(body, "codex");
+    }
+    backend::selected()?.shutdown();
+    fs::remove_dir_all(dir)?;
+    Ok(())
+}

