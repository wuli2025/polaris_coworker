diff --git a/agentd/src/extensions/permissions.ts b/agentd/src/extensions/permissions.ts
new file mode 100644
index 0000000..efedbcb
--- /dev/null
+++ b/agentd/src/extensions/permissions.ts
@@ -0,0 +1,90 @@
+import { homedir } from "node:os";
+import { fileURLToPath } from "node:url";
+import { realpath } from "node:fs/promises";
+import { dirname, resolve, relative, isAbsolute, basename } from "node:path";
+import type { ExtensionFactory } from "@earendil-works/pi-coding-agent";
+import type { PermissionMode } from "../protocol/schema.ts";
+
+export type Decision = "allow" | "deny" | "allowAlways";
+export interface Approval { callId: string; tool: string; summary: string }
+const readers = new Set(["read", "grep", "find", "ls", "web_fetch", "web_search", "subagent"]);
+
+// Resolve the closest existing ancestor, including symlinks, for new files.
+async function canonical(path: string): Promise<string> {
+  try { return await realpath(path); }
+  catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT" || dirname(path) === path) throw error;
+    return resolve(await canonical(dirname(path)), basename(path));
+  }
+}
+// Match the pinned Pi tool path syntax before the containment check. Pi normalizes
+// these forms at execution, so checking their unexpanded spelling would be unsafe.
+export function toolPath(input: string): string {
+  let path = input.replace(/[\u00A0\u2000-\u200A\u202F\u205F\u3000]/g, " ");
+  if (path.startsWith("@")) path = path.slice(1);
+  if (process.platform === "win32" && path.startsWith("/") && !path.startsWith("//") && !path.includes("\\")) {
+    const drive = path.match(/^\/(?:mnt\/|cygdrive\/)?([a-z])(?:\/(.*))?$/i);
+    if (drive) path = `${drive[1].toUpperCase()}:\\${(drive[2] ?? "").replaceAll("/", "\\")}`;
+  }
+  if (path === "~") return homedir();
+  if (path.startsWith("~/") || (process.platform === "win32" && path.startsWith("~\\"))) return resolve(homedir(), path.slice(2));
+  return path.startsWith("file://") ? fileURLToPath(path) : path;
+}
+export async function withinWorkspace(cwd: string, path: unknown): Promise<boolean> {
+  if (typeof path !== "string" || !path) return false;
+  try {
+    const rel = relative(await realpath(cwd), await canonical(resolve(cwd, toolPath(path))));
+    return !isAbsolute(rel) && rel !== ".." && !rel.startsWith("../") && !rel.startsWith("..\\");
+  } catch { return false; }
+}
+export class Permissions {
+  private readonly remembered = new Set<string>();
+  private readonly pending = new Map<string, (decision: Decision) => void>();
+  constructor(public mode: PermissionMode, private readonly cwd: string,
+    private readonly timeoutMs: number, private readonly summaryChars: number,
+    private readonly emit: (approval: Approval) => void) {}
+  configure(mode: PermissionMode): void {
+    this.cancel();
+    this.remembered.clear();
+    this.mode = mode;
+  }
+  respond(callId: string, decision: Decision): boolean {
+    const resolve = this.pending.get(callId);
+    if (!resolve) return false;
+    resolve(decision);
+    return true;
+  }
+  cancel(): void { for (const resolve of this.pending.values()) resolve("deny"); }
+  async check(callId: string, tool: string, args: Record<string, unknown>): Promise<boolean> {
+    if (this.mode === "auto-all" || readers.has(tool)) return true;
+    if (this.mode === "deny") return false;
+    const inside = ["write", "edit"].includes(tool) && await withinWorkspace(this.cwd, args.path);
+    if (this.mode === "auto-current" && inside) return true;
+    // allowAlways is scoped to this exact tool and arguments, in this session.
+    const key = JSON.stringify([tool, args]);
+    if (this.remembered.has(key)) return true;
+    if (this.pending.has(callId)) return false;
+    const decision = await new Promise<Decision>((resolve) => {
+      const timer = setTimeout(() => finish("deny"), this.timeoutMs);
+      const finish = (decision: Decision) => {
+        clearTimeout(timer);
+        this.pending.delete(callId);
+        resolve(decision);
+      };
+      this.pending.set(callId, finish);
+      try { this.emit({ callId, tool, summary: JSON.stringify(args).slice(0, this.summaryChars) }); }
+      catch { finish("deny"); }
+    });
+    if (decision === "allowAlways") this.remembered.add(key);
+    return decision !== "deny";
+  }
+  factory(): ExtensionFactory {
+    return (pi) => {
+      pi.on("tool_call", async (event) => {
+        if (!await this.check(event.toolCallId, event.toolName, event.input)) {
+          return { block: true, reason: "PERMISSION_DENIED: host rejected the operation, approval expired, or the session is read-only." };
+        }
+      });
+    };
+  }
+}
diff --git a/agentd/src/extensions/resources.ts b/agentd/src/extensions/resources.ts
new file mode 100644
index 0000000..ef87124
--- /dev/null
+++ b/agentd/src/extensions/resources.ts
@@ -0,0 +1,20 @@
+import { existsSync, readFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { homedir } from "node:os";
+
+export function expandPath(path: string): string {
+  return resolve(path.startsWith("~/") ? join(homedir(), path.slice(2)) : path);
+}
+export function contextFiles(cwd: string, base: { agentsFiles: { path: string; content: string }[] }) {
+  const files = new Map(base.agentsFiles.map((file) => [dirname(file.path), file]));
+  const parents: string[] = [];
+  for (let dir = resolve(cwd); ; dir = dirname(dir)) {
+    parents.unshift(dir);
+    if (dirname(dir) === dir) break;
+  }
+  for (const dir of parents) {
+    const path = ["AGENTS.md", "CLAUDE.md"].map((name) => join(dir, name)).find(existsSync);
+    if (path) files.set(dir, { path, content: readFileSync(path, "utf8") });
+  }
+  return { agentsFiles: [...files.values()] };
+}
diff --git a/agentd/src/extensions/sandbox.ts b/agentd/src/extensions/sandbox.ts
new file mode 100644
index 0000000..6f41e0f
--- /dev/null
+++ b/agentd/src/extensions/sandbox.ts
@@ -0,0 +1,64 @@
+import type { Config } from "../config/schema.ts";
+import { randomUUID } from "node:crypto";
+import {
+  createBashToolDefinition, createWriteToolDefinition, createEditToolDefinition,
+  type ExtensionFactory,
+} from "@earendil-works/pi-coding-agent";
+
+export interface SandboxRequest { callId: string; operation: string; args: Record<string, unknown> }
+export class Sandbox {
+  private readonly pending = new Map<string, (output: string, error?: string) => void>();
+  constructor(public enabled: boolean, private readonly cwd: string, private readonly config: Config["sandbox"],
+    private readonly emit: (request: SandboxRequest) => void) {}
+  respond(callId: string, output: string, error?: string): boolean {
+    const finish = this.pending.get(callId);
+    if (!finish) return false;
+    finish(output, error);
+    return true;
+  }
+  cancel(): void { for (const finish of this.pending.values()) finish("", "SANDBOX_ABORTED"); }
+  request(operation: string, args: Record<string, unknown>, signal?: AbortSignal): Promise<string> {
+    return new Promise((resolve, reject) => {
+      if (signal?.aborted) return reject(new Error("SANDBOX_ABORTED"));
+      const callId = randomUUID();
+      const abort = () => finish("", "SANDBOX_ABORTED");
+      const timer = setTimeout(() => finish("", "SANDBOX_TIMEOUT: no host execution result"), this.config.timeoutMs);
+      const finish = (output: string, error?: string) => {
+        clearTimeout(timer);
+        signal?.removeEventListener("abort", abort);
+        this.pending.delete(callId);
+        if (error) reject(new Error(error)); else resolve(output);
+      };
+      this.pending.set(callId, finish);
+      signal?.addEventListener("abort", abort, { once: true });
+      try { this.emit({ callId, operation, args: { ...args, cwd: this.cwd, ...this.config } }); }
+      catch { finish("", "SANDBOX_UNAVAILABLE"); }
+    });
+  }
+  factory(): ExtensionFactory {
+    return (pi) => {
+      const writeFile = async (path: string, content: string) => { await this.request("write", { path, content }); };
+      const remoteWrite = createWriteToolDefinition(this.cwd, { operations: {
+        writeFile, mkdir: async (path) => { await this.request("mkdir", { path }); },
+      } });
+      const remoteEdit = createEditToolDefinition(this.cwd, { operations: {
+        writeFile,
+        readFile: async (path) => Buffer.from(await this.request("read", { path }), "base64"),
+        access: async (path) => { await this.request("access", { path }); },
+      } });
+      const remoteBash = createBashToolDefinition(this.cwd, { exposeSessionEnvironment: false, operations: {
+        exec: async (command, _cwd, options) => {
+          const result = await this.request("bash", { command, timeout: options.timeout }, options.signal);
+          options.onData(Buffer.from(result));
+          return { exitCode: 0 };
+        },
+      } });
+      const write = createWriteToolDefinition(this.cwd);
+      const edit = createEditToolDefinition(this.cwd);
+      const bash = createBashToolDefinition(this.cwd);
+      pi.registerTool({ ...write, execute: (...args) => (this.enabled ? remoteWrite : write).execute(...args) });
+      pi.registerTool({ ...edit, execute: (...args) => (this.enabled ? remoteEdit : edit).execute(...args) });
+      pi.registerTool({ ...bash, execute: (...args) => (this.enabled ? remoteBash : bash).execute(...args) });
+    };
+  }
+}
