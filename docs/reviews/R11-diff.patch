+    let response = wire(account_reset(Json(json!({"email":"new@example.com","code":"123456"}))).await).await?;
+    assert_eq!(serde_json::from_slice::<Value>(&response.1).map_err(|e| e.to_string())?,
+        json!({"error":mail::INVALID_CODE}));
+    Ok(())
+}
