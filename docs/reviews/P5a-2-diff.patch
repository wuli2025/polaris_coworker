+mod runtime_status;
+use runtime_status::status;
 
 /// 公开存活探针必须是常量时间、无外部 IO，避免探针本身成为阻塞池 DoS 放大器。
 /// 详细依赖/资源状态由 owner-only 且带缓存的 `/api/status` 提供。
