# Pi 是默认后端。凭据请通过供应商面板配置，保存在 P4 共享 providers.json。
# polaris-data 卷持久化应用配置/凭据，polaris-pi 卷持久化 agentd 会话。
# 保留 polaris-claude 旧凭据卷；切后端不删除任何已有卷。
POLARIS_AGENT_BACKEND=pi
POLARIS_NODE_VERSION=22.19.0
POLARIS_AGENTD_NODE=/usr/local/bin/node
POLARIS_AGENTD_ENTRY=/app/runtime/agentd/dist/src/main.js
POLARIS_AGENTD_ARGS=[]
POLARIS_AGENTD_NODE_ARGS=[]
# 默认 shared：本地单用户部署，所有对话共用同一个 agentd 进程。
# 多账户服务器需要按账号隔离时改为 per-account（需可信登录身份，否则拒绝推理）。
POLARIS_AGENTD_ISOLATION=shared
# 旧后端：构建时设 true，并把 POLARIS_AGENT_BACKEND 改为 claude-cli。
POLARIS_INSTALL_CLAUDE=false

# 复制为 .env 后填写；docker compose 会自动读取。
# ── 旧 Claude 后端兼容环境变量 ──
# A. Claude 官方 API Key
ANTHROPIC_API_KEY=

# B. 第三方 Anthropic 兼容端点（智谱/Kimi/DeepSeek/聚合站等）
#    填 BASE_URL + AUTH_TOKEN，留空 ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# ── 访问口令（服务部署必须设置；公网只允许经 HTTPS 反代访问）──
POLARIS_AUTH_TOKEN=
