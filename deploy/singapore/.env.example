# 仅部署包参数；不以 shell source 执行，不支持变量插值/多行/行尾注释。
# 值可用一层单引号包裹，密码含 $ 时保留为字面量。复制后 chmod 600 .env。
AUTHORITY_DOMAIN=id.example.invalid
RELAY_DOMAIN=relay.example.invalid
ACME_EMAIL=ops@example.invalid
# BLOCKED：由发布负责人提供当前 P6a-2 源码构建且包含 collab-net 的镜像。
# 必须 repo:不可变版本@sha256:64位hex，不接受 latest 或未校验的猜测 digest。
AUTHORITY_IMAGE=
# Dockerfile.relay 固定官方 crate 1.0.1 与 SHA256；构建并发布后填写镜像 digest。
RELAY_IMAGE=
CADDY_IMAGE=caddy:2.10.2-alpine
GATEWAY_IMAGE=haproxy:3.2.26-alpine
# 两个基础镜像版本固定；生产可进一步加 @sha256:...；脚本拒绝 latest。
# SMTP 支持服务端既有 implicit TLS / STARTTLS（按端口）；465 为默认。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 0 邀请制；1 开放注册。绑定邮箱注册、验证码登录/找回要求完整 SMTP。
ACCOUNT_OPEN_SIGNUP=0
# 留空时生成 https://RELAY_DOMAIN；多项逗号分隔；默认不回退公共 relay。
RELAY_URLS=
RELAY_FALLBACK=false
# 权威反代按来源 IP 的 HTTP 请求频控：10 秒内最大请求数，超限返回 429。
# id 橙云时按 Cloudflare 出口 IP 聚合（不信任用户伪造的 CF/XFF 头）。
AUTH_REQUESTS_PER_10S=120
# relay 全局新连接/秒、突发数量、每客户端收包字节/秒和突发字节。
RELAY_ACCEPT_PER_SEC=50
RELAY_ACCEPT_BURST=100
RELAY_RX_BYTES_PER_SEC=10485760
RELAY_RX_BURST_BYTES=20971520
# 策略 B，与成员配置保持一致。
REVOCATION_POLL_SECS=30
REVOCATION_MAX_AGE_SECS=600
NEW_DEVICE_WINDOW_HOURS=24
APPROVAL_TIMEOUT_SECS=300
# 资源与日志轮转；内存 m/g、CPU 正数（最大 64）。
AUTHORITY_MEMORY=1g
AUTHORITY_CPUS=1.0
RELAY_MEMORY=512m
RELAY_CPUS=1.0
CADDY_MEMORY=256m
CADDY_CPUS=0.5
GATEWAY_MEMORY=128m
GATEWAY_CPUS=0.5
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
# 绝对路径或相对 deploy/singapore 的路径；建议位于独立加密盘，不自动上传。
BACKUP_DIR=backups
# 默认 age；仅允许 age/gpg/空值。服务器预装工具，不属于仓库依赖。
BACKUP_ENCRYPT=age
# age 公钥或 gpg 完整公钥指纹；空值会拒绝备份，除非明确确认下方例外。
BACKUP_RECIPIENT=
# 0/1；1 明确确认 BACKUP_DIR 为加密介质，并允许未配置加密时生成明文 tar。
BACKUP_PLAINTEXT_ACK=0
# age 恢复私钥的绝对路径；gpg 恢复使用运维用户的密钥环。
BACKUP_IDENTITY=
# 初始化后填入完整 SHA-256；空值禁止 smoke/upgrade，restore 默认也拒绝。
EXPECTED_FINGERPRINT=
# 0/1；仅灾难恢复人工确认时设 1，缺 pin 时仍输出实际指纹，不能宣称身份已核实。
RESTORE_UNPINNED_ACK=0
# 恢复后本机公钥接口等待预算（秒，1..300）。
RESTORE_VERIFY_TIMEOUT_SECS=30
# 自检默认只验证只读 API；可选独立测试账号，禁止使用真实管理员账号。
SMOKE_USERNAME=
SMOKE_PASSWORD=
# 1 仅在登录明确失败后尝试创建测试账号；重复运行复用，账号不会自动删除。
SMOKE_SIGNUP=0
SMOKE_TIMEOUT_SECS=10
